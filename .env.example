# Copy this file to ".env" and paste your free Groq key (https://console.groq.com/keys).
# Leave it empty to run in offline/rules-only mode: the app still works.
GROQ_API_KEY=
# Optional: choose models (comma-separated, first one is tried first)
# GROQ_MODEL=llama-3.3-70b-versatile,llama-3.1-8b-instant
